[Application Options]
; start in collapsed diff mode
collapsed = false

; start in compact diff mode (small context around changes)
compact = true

; show line numbers in diff gutter
line-numbers = true

; UI theme (overrides chroma-style with the theme's own setting)
theme = tokyonight-custom

; show untracked files in the tree
untracked = true

; highlight intra-line word-level changes in paired add/remove lines
word-diff = true
