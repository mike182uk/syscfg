{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "tokyonight_mike"
  },
  "keybinds": {
    "session.sidebar.toggle": ["ctrl+alt+super+shift+\\", "<leader>b"]
  },
  "prompt": {
    "image_preview": true
  },
  "session": {
    "sidebar": "hide",
    "scrollbar": false,
    "thinking": "hide",
    "image_preview": true
  },
  "animations": true,
  "plugins": ["./herdr-opencode"]
}
