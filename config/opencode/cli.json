{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "tokyonight_mike"
  },
  "keybinds": {
    "session.sidebar.toggle": ["ctrl+alt+super+shift+\\", "<leader>b"]
  },
  "diffs": {
    "wrap": "word",
    "single": true
  },
  "prompt": {
    "image_preview": true
  },
  "session": {
    "sidebar": "hide",
    "scrollbar": false,
    "thinking": "hide",
    "image_preview": true
  },
  "animations": true,
  "plugins": ["./herdr-opencode"],
  "mini": {
    "thinking": "hide",
    "work_spinner": "block-shuttle",
    "mono": false,
    "splash": "show",
    "footer": "show",
    "turn_summary": "show",
    "shell_output": "hide",
    "tools": "hide"
  }
}
