// https://opencode.ai/v2/docs/config
{
  "$schema": "https://opencode.ai/config.json",
  "update": "disable", // updates managed by brew
  "mcp": {
    "servers": {
      // https://github.com/ChromeDevTools/chrome-devtools-mcp
      "chrome-devtools": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "chrome-devtools-mcp@latest"
        ],
        "disabled": true
      },
      // https://cua.ai/cua-driver
      "cua-driver": {
        "type": "local",
        "command": [
          "cua-driver",
          "mcp"
        ],
        "disabled": true
      },
      "incidentio-work": {
        "type": "remote",
        "url": "https://mcp.incident.io/mcp",
        "disabled": true
      },
      // https://linear.app/docs/mcp
      "linear-work": {
        "type": "remote",
        "url": "https://mcp.linear.app/mcp",
        "disabled": true
      },
      // https://developers.notion.com/guides/mcp/get-started-with-mcp
      "notion-work": {
        "type": "remote",
        "url": "https://mcp.notion.com/mcp",
        "disabled": true
      },
      // https://github.com/microsoft/playwright-mcp
      "playwright": {
        "type": "local",
        "command": [
          "npx",
          "@playwright/mcp@latest"
        ],
        "disabled": true
      },
      // https://docs.sentry.io/product/sentry-mcp
      "sentry-work": {
        "type": "remote",
        "url": "https://mcp.sentry.dev/mcp",
        "disabled": true
      },
      // https://executor.sh/docs
      "executor": {
        "type": "remote",
        "url": "{env:EXECUTOR_URL}",
        "headers": {
          "Authorization": "Bearer {env:EXECUTOR_TOKEN_OC}"
        },
        "oauth": false,
        "codemode": false // Executor is already a code-mode server
      }
    }
  },
  // https://models.dev
  "model": "anthropic/claude-opus-5-5", //"openai/gpt-6.1-sol",
  "agents": {
    "title": {
      "model": "anthropic/claude-haiku-5-5",//"openai/gpt-6-luna",
    }
  },
  // Default-allow with ask/deny on irreversible or public actions.
  // Last matching rule wins: broad rules first, narrow rules last.
  // In-project changes are recoverable via git + per-message snapshots (/undo).
  // Anything touching paths outside the project still prompts via external_directory.
  "permissions": [
    { "action": "read", "resource": "*", "effect": "allow" },
    { "action": "read", "resource": "*.env", "effect": "deny" },
    { "action": "read", "resource": "*.env.*", "effect": "deny" },
    { "action": "read", "resource": "*.env.example", "effect": "allow" },
    { "action": "shell", "resource": "*", "effect": "allow" },
    // local but destructive -> ask
    { "action": "shell", "resource": "rm -rf *", "effect": "ask" },
    { "action": "shell", "resource": "rm -fr *", "effect": "ask" },
    { "action": "shell", "resource": "git reset --hard*", "effect": "ask" },
    { "action": "shell", "resource": "brew install*", "effect": "ask" },
    { "action": "shell", "resource": "brew uninstall*", "effect": "ask" },
    // public or irreversible -> ask
    { "action": "shell", "resource": "git push*", "effect": "ask" },
    { "action": "shell", "resource": "gh pr create*", "effect": "ask" },
    { "action": "shell", "resource": "gh pr merge*", "effect": "ask" },
    { "action": "shell", "resource": "gh pr close*", "effect": "ask" },
    { "action": "shell", "resource": "gh pr comment*", "effect": "ask" },
    { "action": "shell", "resource": "gh pr review*", "effect": "ask" },
    { "action": "shell", "resource": "gh issue create*", "effect": "ask" },
    { "action": "shell", "resource": "gh issue comment*", "effect": "ask" },
    { "action": "shell", "resource": "gh issue close*", "effect": "ask" },
    { "action": "shell", "resource": "gh release create*", "effect": "ask" },
    { "action": "shell", "resource": "gh repo create*", "effect": "ask" },
    { "action": "shell", "resource": "gh repo delete*", "effect": "ask" },
    { "action": "shell", "resource": "gh gist create*", "effect": "ask" },
    { "action": "shell", "resource": "npm publish*", "effect": "ask" },
    { "action": "shell", "resource": "pnpm publish*", "effect": "ask" },
    { "action": "shell", "resource": "yarn publish*", "effect": "ask" },
    { "action": "shell", "resource": "bun publish*", "effect": "ask" },
    { "action": "shell", "resource": "docker push*", "effect": "ask" },
    // never
    { "action": "shell", "resource": "sudo *", "effect": "deny" },
    { "action": "shell", "resource": "rm -rf /", "effect": "deny" },
    { "action": "shell", "resource": "rm -fr /", "effect": "deny" },
    // external directories
    { "action": "external_directory", "resource": "*", "effect": "ask" },
    { "action": "external_directory", "resource": "{env:DEV_DIR}/repos/*", "effect": "allow" },
    { "action": "external_directory", "resource": "{env:DEV_DIR}/worktrees/*", "effect": "allow" },
    { "action": "external_directory", "resource": "{env:SCRATCH_DIR}/*", "effect": "allow" },
    { "action": "external_directory", "resource": "$HOME/.opensrc/*", "effect": "allow" },
    { "action": "external_directory", "resource": "/tmp/*", "effect": "allow" },
    { "action": "external_directory", "resource": "/private/tmp/*", "effect": "allow" },
    { "action": "external_directory", "resource": "/var/folders/*", "effect": "allow" },
    { "action": "external_directory", "resource": "/private/var/folders/*", "effect": "allow" },
    { "action": "external_directory", "resource": "/run/user/*", "effect": "allow" }
  ],
  "plugins": [
    // https://github.com/ex-machina-co/opencode-anthropic-auth/tree/v2/main
    "@ex-machina/opencode-anthropic-auth@2.0.0-next.6",
    // https://github.com/backnotprop/plannotator
    "@plannotator/opencode@0.28.25"
  ],
  "share": "disabled",
  "websearch": false
}
